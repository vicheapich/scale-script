# Copy this file to .env (next to test_scale.py or test_scale.exe) and fill it in.
# .env is git-ignored. Never commit the real secret.

WEBHOOK_URL=https://dev.cambodiapost.com.kh/api/webhook/notify

# Must equal the Laravel IPS_SIGN_SECRET (config/address.php -> ips_sign_secret).
# Used as literal text (not hex-decoded), exactly like PHP hash_hmac().
WEBHOOK_SECRET=

# Seconds
WEBHOOK_TIMEOUT=10
